{
	"title": "Authoritative Overlay",
	"protocol": "authoritative-overlay://",
	"classType": [
		"guard"
	],
	"capabilities": [
		"experimental"
	],
	"register": "filter",
	"node": "python",
	"path": "nodes.authoritative_overlay",
	"prefix": "authoritative_overlay",
	"description": [
		"Cross-checks extracted financial numbers against official regulator data ",
		"(US SEC, EU/UK IFRS, UK Companies House, Japan EDINET). ",
		"Abstains (drops) the answer if there is no match."
	],
	"icon": "util-guard.svg",
	"lanes": {
		"text": [
			"answers"
		],
		"answers": [
			"answers"
		]
	},
	"preconfig": {
		"default": "basic",
		"profiles": {
			"basic": {
				"title": "Basic: US SEC (EDGAR)",
				"regulator_type": "sec"
			},
			"ifrs": {
				"title": "EU/UK IFRS",
				"regulator_type": "ifrs"
			},
			"companies_house": {
				"title": "UK Companies House",
				"regulator_type": "companies_house"
			},
			"edinet": {
				"title": "Japan EDINET",
				"regulator_type": "edinet"
			}
		}
	},
	"fields": {
		"regulator_type": {
			"type": "string",
			"title": "Regulator Source",
			"description": "Which regulator database to cross-check against",
			"default": "sec",
			"enum": [
				[
					"sec",
					"US SEC (EDGAR)"
				],
				[
					"ifrs",
					"EU/UK IFRS"
				],
				[
					"companies_house",
					"UK Companies House"
				],
				[
					"edinet",
					"Japan EDINET"
				]
			]
		},
		"authoritative_overlay.basic": {
			"object": "basic",
			"properties": [
				"regulator_type"
			]
		},
		"authoritative_overlay.ifrs": {
			"object": "ifrs",
			"properties": [
				"regulator_type"
			]
		},
		"authoritative_overlay.companies_house": {
			"object": "companies_house",
			"properties": [
				"regulator_type"
			]
		},
		"authoritative_overlay.edinet": {
			"object": "edinet",
			"properties": [
				"regulator_type"
			]
		},
		"authoritative_overlay.profile": {
			"title": "Profile",
			"description": "Overlay profile",
			"type": "string",
			"default": "basic",
			"enum": [
				"*>preconfig.profiles.*.title"
			],
			"conditional": [
				{
					"value": "basic",
					"properties": [
						"authoritative_overlay.basic"
					]
				},
				{
					"value": "ifrs",
					"properties": [
						"authoritative_overlay.ifrs"
					]
				},
				{
					"value": "companies_house",
					"properties": [
						"authoritative_overlay.companies_house"
					]
				},
				{
					"value": "edinet",
					"properties": [
						"authoritative_overlay.edinet"
					]
				}
			]
		}
	},
	"shape": [
		{
			"section": "Pipe",
			"title": "Authoritative Overlay",
			"properties": [
				"authoritative_overlay.profile"
			]
		}
	],
	"test": [
		{
			"profiles": [
				"basic"
			],
			"cases": [
				{
					"text": "{\"concept\": \"Revenues\", \"value\": \"$15,000,000\"}",
					"expect": {
						"answers": {
							"notEmpty": true
						}
					}
				},
				{
					"text": "{\"concept\": \"NetIncomeLoss\", \"value\": \"(3.2)m\"}",
					"expect": {
						"answers": {
							"notEmpty": true
						}
					}
				},
				{
					"text": "{\"concept\": \"Revenues\", \"value\": \"$999,000\"}",
					"expect": {
						"answers": {
							"notEmpty": false
						}
					}
				}
			]
		},
		{
			"profiles": [
				"ifrs"
			],
			"cases": [
				{
					"text": "{\"concept\": \"Revenues\", \"value\": \"$25,000,000\"}",
					"expect": {
						"answers": {
							"notEmpty": true
						}
					}
				},
				{
					"text": "{\"concept\": \"Revenues\", \"value\": \"$15,000,000\"}",
					"expect": {
						"answers": {
							"notEmpty": false
						}
					}
				}
			]
		}
	]
}

