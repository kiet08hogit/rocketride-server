+def test_services_json_shape():
+    data = json.loads(_SERVICES_JSON.read_text())
+    assert data['classType'] == ['tool']
+    assert data['capabilities'] == ['invoke']
+    assert data['lanes'] == {}  # tool node: no data lanes
